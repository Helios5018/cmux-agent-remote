{
  "name": "cmux-agent-remote",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Mac 本地的多 Agent Web 控制中心：远程查看与控制运行在 cmux 中的 Claude Code / Codex / Grok / Pi",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "cmux-agent-remote": "./bin/cmux-agent-remote.js"
  },
  "scripts": {
    "dev": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run apps/server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "install-hooks": "bun run scripts/install-hooks.ts",
    "uninstall-hooks": "bun run scripts/uninstall-hooks.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  }
}
